{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:components": "vitest -c vitest.components.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:owasp": "owasp-dependency-check --project \"Demo Next 15\" -f HTML JSON --nvdApiKey 333 -s './src/**/*' --exclude node_modules --exclude .husky --exclude .next --exclude .git --exclude 'test*/**/*' --exclude playwright-report --exclude dependency-check-bin --exclude dependency-check-reports",
    "test:owasp:report": "google-chrome-stable dependency-check-reports/dependency-check-report.html",
    "test:depscan": "depscan --src $PWD --reports-dir $PWD/reports",
    "docs": "typedoc --entryPointStrategy expand --tsconfig tsconfig.json --out docs --name 'Coach Studio Coach'",
    "docker": "pnpm run docker:prune & pnpm run docker:build & pnpm run docker:run",
    "docker:build": "docker build -t aina-demo",
    "docker:remove": "docker rmi aina-demo",
    "docker:prune": "docker system prune -a -f",
    "docker:run": "docker run -p 3000:3000 aina-demo:latest"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "next": "15.0.3",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "react-hook-form": "^7.53.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "uuid": "^11.0.3",
    "uuid-validate": "^0.0.3",
    "winston": "^3.17.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@playwright/experimental-ct-react": "^1.49.0",
    "@playwright/test": "^1.49.0",
    "@redux-devtools/extension": "^3.3.0",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid-validate": "^0.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "2.1.6",
    "eslint": "^9",
    "eslint-config-next": "15.0.3",
    "happy-dom": "^15.11.7",
    "postcss": "^8",
    "prettier": "^3.4.1",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^2.1.6"
  },
  "packageManager": "pnpm@9.14.3"
}
